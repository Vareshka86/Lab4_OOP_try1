# Конфигурация Doxygen для лабораторной работы №4.
#
# Здесь перечислены только параметры, отличающиеся от значений по умолчанию;
# все остальные параметры Doxygen берёт по умолчанию.
# Полный список параметров с описанием: doxygen -g Doxyfile.full
#
# Сборка документации (из корня проекта):
#     doxygen Doxyfile
# Результат: docs/html/index.html

#---------------------------------------------------------------------------
# Общие сведения о проекте
#---------------------------------------------------------------------------
PROJECT_NAME           = "Лабораторная работа №4 по ООП"
PROJECT_NUMBER         = v0.1
PROJECT_BRIEF          = "Иерархия устройств умного дома с наследованием"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Russian

#---------------------------------------------------------------------------
# Что документировать
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES   # Все объекты попадают в документацию
EXTRACT_PRIVATE        = YES   # Включать приватные члены классов
EXTRACT_STATIC         = YES   # Включать статические функции и переменные
EXTRACT_ANON_NSPACES   = YES   # Включать функции из безымянных namespace
SORT_MEMBER_DOCS       = NO    # Порядок как в исходном коде, а не по алфавиту

#---------------------------------------------------------------------------
# Входные файлы
#---------------------------------------------------------------------------
INPUT                  = README.md CHANGELOG.md pages include src
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.hpp *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md   # README - главная страница документации

#---------------------------------------------------------------------------
# Исходный код в документации
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES   # Страницы с исходным кодом
STRIP_CODE_COMMENTS    = NO    # Показывать комментарии в листингах

#---------------------------------------------------------------------------
# Предупреждения (проверка полноты документации)
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES   # Предупреждать о неописанных параметрах

#---------------------------------------------------------------------------
# Форматы вывода
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES   # Дерево навигации слева
HAVE_DOT               = NO    # Graphviz не используется

#---------------------------------------------------------------------------
# Диаграммы (ЛР №2 и дальше): картинки uml/*.png рисует PlantUML командой
#   java -jar D:\Tools\plantuml\plantuml.jar -charset UTF-8 -tpng uml\*.puml
# а Doxygen только вставляет их (\plantumlfile не работает при кириллице в пути).
# Строки Graphviz - только после его установки.
# Подробности - references/classes-labs.md скилла lab-part.
#---------------------------------------------------------------------------
IMAGE_PATH             = uml   # для картинок uml/*.png на страницах
# HAVE_DOT             = YES   # графы наследования - нужен Graphviz
# DOT_PATH             = <папка с dot.exe>
# UML_LOOK             = YES
