@startuml
title Диаграмма классов: устройства умного дома (вариант 5), версия v1.0
skinparam classAttributeIconSize 0
hide empty members

abstract class SmartDevice {
  - name_ : std::string
  - isOn_ : bool
  - {static} existingCount_ : int
  --
  # SmartDevice(name : std::string)
  # SmartDevice(other : SmartDevice)
  # operator=(other : SmartDevice) : SmartDevice&
  + ~SmartDevice() {virtual}
  + {abstract} turnOn() : bool
  + {abstract} turnOff() : bool
  + {abstract} getStatus() : std::string
  + getName() : std::string
  + isOn() : bool
  + {static} getExistingCount() : int
  # setOn(on : bool) : void
}

abstract class PoweredDevice {
  - powerConsumption_ : double
  - energyKWh_ : double
  - meterStartHours_ : double
  - {static} totalEnergyKWh_ : double
  - {static} clockHours_ : double
  --
  # PoweredDevice(name : std::string, powerConsumption : double)
  # PoweredDevice(other : PoweredDevice)
  # operator=(other : PoweredDevice) : PoweredDevice&
  + turnOn() : bool
  + turnOff() : bool
  + getPowerUsage() : double {virtual}
  + getPowerConsumption() : double
  + getEnergyConsumed() : double
  + {static} getTotalEnergyConsumed() : double
  + {static} getClockHours() : double
  + {static} advanceClock(hours : double) : void
  # updateMeter() : void
}

class LightBulb {
  - brightness_ : int
  - color_ : std::string
  --
  + {static} MIN_BRIGHTNESS : int = 1
  + {static} MAX_BRIGHTNESS : int = 100
  + LightBulb(name : std::string, power : double, brightness : int, color : std::string)
  + LightBulb(other : LightBulb)
  + operator=(other : LightBulb) : LightBulb&
  + ~LightBulb()
  + getPowerUsage() : double
  + getStatus() : std::string
  + getBrightness() : int
  + getColor() : std::string
  + setBrightness(brightness : int) : void
  + setColor(color : std::string) : void
}

class Thermostat {
  - temperature_ : int
  - mode_ : Mode
  --
  + {static} MIN_TEMPERATURE : int = 5
  + {static} MAX_TEMPERATURE : int = 35
  + Thermostat(name : std::string, power : double, temperature : int, mode : Mode)
  + Thermostat(other : Thermostat)
  + operator=(other : Thermostat) : Thermostat&
  + ~Thermostat()
  + getStatus() : std::string
  + getTemperature() : int
  + getMode() : Mode
  + setTemperature(temperature : int) : void
  + setMode(mode : Mode) : void
  + {static} modeName(mode : Mode) : std::string
}

enum "Thermostat::Mode" as Mode {
  Heating
  Cooling
  Eco
}

interface ISensor {
  # ISensor(other : ISensor)
  # operator=(other : ISensor) : ISensor&
  + ~ISensor() {virtual}
  + {abstract} getCurrentVoltage() : double
}

class SmartOutlet {
  - load_ : double
  - voltage_ : double
  --
  + {static} MIN_VOLTAGE : int = 180
  + {static} MAX_VOLTAGE : int = 260
  + SmartOutlet(name : std::string, maxPower : double, load : double, voltage : double)
  + SmartOutlet(other : SmartOutlet)
  + operator=(other : SmartOutlet) : SmartOutlet&
  + ~SmartOutlet()
  + getPowerUsage() : double
  + getStatus() : std::string
  + getCurrentVoltage() : double
  + getCurrentAmperage() : double
  + getLoad() : double
  + setLoad(load : double) : void
  + setVoltage(voltage : double) : void
}

SmartDevice <|-- PoweredDevice
PoweredDevice <|-- LightBulb
PoweredDevice <|-- Thermostat
PoweredDevice <|-- SmartOutlet
ISensor <|.. SmartOutlet
Thermostat +-- Mode

note right of SmartDevice
  Уровень 1: абстрактный базовый класс.
  turnOn, turnOff, getStatus - чисто виртуальные.
end note

note right of PoweredDevice
  Уровень 2: промежуточный, тоже абстрактный
  (getStatus по-прежнему чисто виртуальная).
  getPowerUsage - виртуальная с реализацией
  по умолчанию: включено -> номинальная мощность.
  Энергия: Вт x часы / 1000 = кВт·ч.
end note

note right of LightBulb
  Уровень 3: конкретный класс.
  getPowerUsage переопределена:
  номинальная мощность x яркость / 100.
end note

note bottom of Thermostat
  Уровень 3: конкретный класс.
  getPowerUsage не переопределена -
  работает реализация по умолчанию.
end note

note bottom of SmartOutlet
  Уровень 3: множественное наследование -
  PoweredDevice (устройство с питанием)
  и ISensor (датчик напряжения).
  getPowerUsage переопределена: нагрузка.
  Ромба нет: ISensor не наследует SmartDevice.
end note

note "Часть 4 (v1.0): конструкторы копирования и присваивание\nс учётом состояния. В абстрактных классах они защищены\n(#), в конкретных - открытые." as CopyNote
@enduml
